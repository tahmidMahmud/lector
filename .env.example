# ---------------------------------------------------------------------------
# Lector configuration. Copy to .env and edit:  cp .env.example .env
# Used by docker-compose.yml both for host paths (variable substitution) and as
# the container environment (env_file). Empty values fall back to the defaults.
# ---------------------------------------------------------------------------

# ===== Host side (docker compose) ==========================================
# Host port for the web UI / API (container listens on 5000).
LECTOR_PORT=5055
# Host folder for Lector's data: SQLite DB, secret key, covers, chapter audio, M4B files.
# Audio is large (~29 MB per narrated hour), so keep it on the big drive.
LECTOR_DATA_PATH=/Volumes/mediaDrive/media-server/lector
# Host folder that Kavita mounts as /books. Mounted read-only into Lector at /books.
BOOKS_PATH=/Volumes/mediaDrive/media-server/downloads/media/books
# Host folder holding kokoro-v1.0.onnx (325 MB) and voices-v1.0.bin (28 MB).
# If the files are absent they are downloaded here on first use, so it must be writable.
KOKORO_MODELS_PATH=/Users/tmahmud/.claude/skills/metaphor-art-reel/.kokoro-models

# Run the app as this uid/gid (the entrypoint drops root with gosu). Leave PUID empty to run
# as root. 501/20 is the first macOS user / "staff" group.
PUID=501
PGID=20
TZ=America/Chicago

# ===== Kavita ===============================================================
# Base URL of Kavita as seen from inside the Lector container.
#   Same docker network (default compose): http://kavita:5000
#   Not on that network (Docker Desktop):   http://host.docker.internal:5050
KAVITA_URL=http://kavita:5000
# Preferred auth: Kavita API key. In Kavita: user menu (top right) -> Settings ->
# "3rd Party Clients" (also shown on the OPDS section) -> copy the API key.
# Lector exchanges it for a token via /api/Plugin/authenticate.
KAVITA_API_KEY=
# Alternative: a Kavita username + password (used only when KAVITA_API_KEY is empty).
KAVITA_USERNAME=
KAVITA_PASSWORD=
# Comma-separated Kavita library types to import. 2 = Book (EPUB). 4 = Light Novel.
# (0 = Manga, 1 = Comic, 3 = Image are image-based and cannot be narrated.)
KAVITA_LIBRARY_TYPES=2
# Translate Kavita's file paths to Lector's mounts: "kavitaPrefix=lectorPrefix;..." .
# Kavita sees books at /books and so does Lector, hence the identity mapping. If a mapped
# file does not exist, Lector downloads a private copy through Kavita's API instead
# (needs the "Download" role on the Kavita user) into /data/cache/books.
KAVITA_PATH_MAP=/books=/books
# Minutes between automatic library syncs (first one ~5 s after start). 0 disables;
# admins can still press "Sync now".
SYNC_INTERVAL_MINUTES=60

# ===== Text-to-speech =======================================================
# kokoro = built-in Kokoro-82M via kokoro-onnx on CPU.
# openai = any OpenAI-compatible /v1/audio/speech server (e.g. Kokoro-FastAPI, openedai-speech).
TTS_ENGINE=kokoro
# Download the Kokoro model files into /models if they are missing.
KOKORO_AUTO_DOWNLOAD=true
# onnxruntime intra-op threads. 0 = onnxruntime default (all cores the container sees).
TTS_THREADS=0
# Used only when TTS_ENGINE=openai.
TTS_OPENAI_URL=http://localhost:8880/v1
TTS_OPENAI_KEY=not-needed
TTS_OPENAI_MODEL=kokoro
# Defaults for new narrations (admins can change these at runtime in the UI).
DEFAULT_VOICE=af_heart
DEFAULT_SPEED=1.0
# Output codec for chapter files: mp3 or m4a (AAC). Mono.
AUDIO_FORMAT=mp3
AUDIO_BITRATE=64k

# ===== Users & sessions =====================================================
# Cookie-signing secret. Leave empty to auto-generate one in /data/secret.key.
LECTOR_SECRET_KEY=
# Let anyone create an account from the login page (the first account is always the admin).
ALLOW_REGISTRATION=false
# Let non-admin users queue new narrations (otherwise only admins can).
ALLOW_USER_REQUESTS=true
# Login session lifetime in days.
SESSION_DAYS=30
# Set true when Lector is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# ===== Misc =================================================================
LOG_LEVEL=INFO

# ===== Advanced (container paths; normally leave unset) =====================
# LECTOR_DATA_DIR=/data              # set by docker-compose.yml
# LECTOR_AUDIO_DIR=/data/audio       # where chapter audio and M4B files go
# LECTOR_DB_PATH=/data/lector.db     # SQLite database file
# KOKORO_MODEL=/models/kokoro-v1.0.onnx    # set by docker-compose.yml
# KOKORO_VOICES=/models/voices-v1.0.bin    # set by docker-compose.yml
